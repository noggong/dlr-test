# docker compose · iac/local.sh 가 읽는 값. 이 파일을 iac/.env(gitignore)로 복사해 값을 적는다 — 비우면 compose 기본값.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
AUTH_JWT_SECRET=
AUTH_COOKIE_SECURE=
API_PORT=
REALTIME_PORT=
WEB_PORT=
# 시각 주입(game.clock-offset) — 비우면 0s. 예: -3600s. 종단 테스트(frontend/e2e/run.sh)는 셸 변수로 넘긴다.
GAME_CLOCKOFFSET=
# 로컬 데모 시계(prd D25 · SPEC platform §6) — 비우면 켜짐(true) · 첫 기동 3m 뒤가 게임 07:00. 끄려면 false
GAME_DEMO_ENABLED=
GAME_DEMO_LEAD=
# api 의 Spring 프로필 — 적지 않으면 local-seed(로컬 회원 500명 · 그룹 시드, SPEC platform §7). 다른 값과 달리 빈 값도 그대로 쓰여
# `API_PROFILES=` 로 적으면 시드를 넣지 않는다(종단 테스트가 이렇게 끈다). 그래서 기본은 주석으로 둔다.
# API_PROFILES=local-seed
# 워크트리 격리(SPEC platform §5) — 비우면 iac/local.sh 가 정한다: 레포 루트는 local · group-mission, 워크트리는 브랜치 이름.
# COMPOSE_PROJECT_NAME 은 iac/local.sh 만 읽는다(docker compose 를 직접 부를 때는 -p 로 준다).
IMAGE_TAG=
COMPOSE_PROJECT_NAME=
